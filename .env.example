# Live delivery + AI — copy to .env and fill in. NEVER commit .env.
#
# Without any of these set, the agent runs with deterministic stub adapters.
# Each variable is optional and only activates the matching real integration.

# --- Real email delivery (SMTP relay via Zoho Mail) ----------------------
# Port 465 with SSL, or 587 with STARTTLS. Use an app-specific password.
# ALERT_SMTP_HOST=smtp.zoho.com
# ALERT_SMTP_PORT=465
# ALERT_SMTP_USER=you@yourdomain.com
# ALERT_SMTP_PASS=your-app-specific-password
# ALERT_SMTP_SSL=1
# ALERT_EMAIL_FROM=you@yourdomain.com

# --- Real Slack delivery (incoming webhooks, one per channel) -------
# JSON map: stakeholder channel endpoint -> webhook URL
# ALERT_SLACK_WEBHOOKS='{"sarah.slack":"https://hooks.slack.com/services/T000/B000/XXX","david.slack":"https://hooks.slack.com/services/T000/B000/YYY"}'

# --- AI prose + agentic layer (Anthropic) -----------------------------
# ALERT_AI_API_KEY=sk-ant-...
# ALERT_AI_MODEL=claude-haiku-4-5
# ALERT_AI_BASE_URL=https://api.anthropic.com/v1/messages
# ALERT_RECORD_INCIDENTS=1   # opt-in: append resolved alerts to incidents/ (triage KB)

# --- Misc -----------------------------------------------------------
# ALERT_ENV_FILE=/abs/path/to/.env   # custom env file location
